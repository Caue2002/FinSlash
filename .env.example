DATABASE_URL=postgresql://finslash_api:SUBSTITUA_A_SENHA@HOST:5432/NOME_DO_BANCO
ALLOWED_ORIGIN=https://SEU-DOMINIO.vercel.app
RATE_LIMIT_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
CRON_SECRET=GERE_OUTRO_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
GEMINI_API_KEY=GEMINI_API_KEY_OPCIONAL
# Fila de modelos Gemini em ordem de prioridade (opcional; sobrescreve GEMINI_MODEL).
# Default: gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# Fallback de modelo unico (usado quando GEMINI_MODELS nao esta definida).
GEMINI_MODEL=gemini-2.5-flash
# Teto de tokens (input+output) por modelo por dia UTC antes do fallback. Default: 1000000.
# GEMINI_MODEL_TOKEN_LIMIT=1000000
