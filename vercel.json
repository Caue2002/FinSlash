{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api?route=/api/v1/:path*"
    },
    {
      "source": "/api/internal/cleanup-rate-limits",
      "destination": "/api?route=/api/internal/cleanup-rate-limits"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cleanup-rate-limits",
      "schedule": "0 3 * * *"
    }
  ]
}
