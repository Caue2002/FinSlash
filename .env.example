DATABASE_URL=postgresql://finslash_api:SUBSTITUA_A_SENHA@HOST:5432/NOME_DO_BANCO
ALLOWED_ORIGIN=https://SEU-DOMINIO.vercel.app
RATE_LIMIT_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
CRON_SECRET=GERE_OUTRO_SEGREDO_ALEATORIO_COM_32_OU_MAIS_CARACTERES
GEMINI_API_KEY=GEMINI_API_KEY_OPCIONAL
# Fila de modelos Gemini em ordem de prioridade (opcional; sobrescreve GEMINI_MODEL).
# Fila verificada ao vivo: gemini-3.5-flash-lite e gemini-flash-lite-latest
# responderam 200; flash 3.x dao 503 intermitente; a familia 2.5 retorna 404
# para contas novas ("no longer available to new users").
# Default: gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.8-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3-flash-preview,gemini-flash-latest
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash
# Fallback de modelo unico (usado quando GEMINI_MODELS nao esta definida).
GEMINI_MODEL=gemini-3.5-flash-lite
# Limite de requisicoes/dia (RPD) por modelo antes do fallback. O Google nao
# publica os valores free tier — confira os seus em AI Studio > Rate limits e
# ajuste aqui no formato modelo:limite. Sem configuracao, usa estimativas
# conservadoras por modelo.
# GEMINI_MODEL_LIMITS=gemini-3.8-flash:500,gemini-2.5-flash:250
# Teto global de requisicoes/dia para modelos fora de GEMINI_MODEL_LIMITS.
# GEMINI_MODEL_REQUEST_LIMIT=500
# Teto opcional de tokens (input+output) por modelo por dia UTC. Desligado por
# padrao porque tokens/dia nao e uma cota publicada pela Google.
# GEMINI_MODEL_TOKEN_LIMIT=1000000
# Orcamento total de tempo da fila de modelos em ms (padrao 16000). O frontend
# desiste em ~25s; sem esse teto, uma sequencia de modelos lentos estourava o
# timeout do cliente antes da resposta chegar.
# GEMINI_FILA_TIMEOUT_MS=16000
